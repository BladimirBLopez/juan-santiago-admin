generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipoMedia {
  IMAGEN
  VIDEO
  AUDIO
}

model Testimonio {
  id          String     @id @default(cuid())
  nombre      String
  servicio    ServicioTipo?
  texto       String
  mediaUrl    String?
  mediaTipo   TipoMedia?
  visible     Boolean    @default(true)
  createdAt   DateTime   @default(now())
}

model Configuracion {
  id        String   @id @default(cuid())
  clave     String   @unique
  valor     String
  updatedAt DateTime @updatedAt
}

model Precio {
  id       String       @id @default(cuid())
  servicio ServicioTipo @unique
  monto    Float
  updatedAt DateTime    @updatedAt
}

model Admin {
  id       String @id @default(cuid())
  usuario  String @unique
  password String
  createdAt DateTime @default(now())
}

model Cliente {
  id              String   @id @default(cuid())
  nombre          String
  fechaNacimiento DateTime?
  telefono        String?
  createdAt       DateTime @default(now())
  consultas       Consulta[]
}

enum ServicioTipo {
  AMARRE
  ENDULZAMIENTO
  RETORNO
  ALEJAMIENTO
  UNION_PAREJA
  CONSULTA_TAROT
  CONSULTA_COCA
}

enum ConsultaEstado {
  NUEVO
  EN_PROCESO
  COMPLETADO
}

model Consulta {
  id           String         @id @default(cuid())
  clienteId    String
  cliente      Cliente        @relation(fields: [clienteId], references: [id])
  servicio     ServicioTipo
  situacion    String
  estado       ConsultaEstado @default(NUEVO)
  fechaInicio  DateTime?
  diasTrabajo  Int?
  notas        String?
  createdAt    DateTime       @default(now())
  pagos        Pago[]
  seguimientos Seguimiento[]
}

enum PagoEstado {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model Pago {
  id             String     @id @default(cuid())
  consultaId     String
  consulta       Consulta   @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  monto          Float
  comprobanteUrl String
  estado         PagoEstado @default(PENDIENTE)
  verificadoOcr  Boolean    @default(false)
  aprobadoAt     DateTime?
  createdAt      DateTime   @default(now())
}

enum SeguimientoTipo {
  RECORDATORIO_AVANCE
  TESTIMONIO
  AVISO_PAGO
}

model Seguimiento {
  id         String          @id @default(cuid())
  consultaId String
  consulta   Consulta        @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  tipo       SeguimientoTipo
  enviado    Boolean         @default(false)
  fechaEnvio DateTime?
  createdAt  DateTime        @default(now())
}
